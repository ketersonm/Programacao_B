#include <iostream>
#include <string>

using namespace std;

int contarVogais(string frase) {
    int quantidadeVogais = 0;
    for (int i = 0; i < frase.size(); i++) {
        char letra = frase[i];
        if (letra == 'a' || letra == 'e' || letra == 'i' || letra == 'o' || letra == 'u') {
            quantidadeVogais++;
        }
    }
    return quantidadeVogais;
}

int main() {
    string frase;
    int quantidadeVogais;

    cout << "Digite uma frase: ";
    getline(cin, frase);    
    quantidadeVogais = contarVogais(frase);
    cout << "A frase contém " << quantidadeVogais << " vogais." << endl;
    return 0;
}